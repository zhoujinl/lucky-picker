{
  "name": "lucky-picker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "vue-tsc --noEmit && node --experimental-sqlite node_modules/vite/bin/vite.js build",
    "preview": "node --experimental-sqlite node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node --experimental-sqlite node_modules/vitest/vitest.mjs run",
    "update:stocks": "node scripts/update-stocks.mjs",
    "update:hot-stocks": "node scripts/update-hot-stocks.mjs",
    "start": "node --experimental-sqlite scripts/server.mjs",
    "package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
